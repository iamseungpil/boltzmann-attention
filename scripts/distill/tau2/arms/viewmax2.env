# ★T3′ 팔 — viewscale_max(압축 경로 ① 차단) + **신규 술어 2종을 계기로만**.
#   왜 계기부터: 오늘 §T-9 가 보여줬듯 **반려는 그 자체로 고치지 못한다**(61회 중 49회가 그대로
#   실행 · 036 은 10회 반려 끝에 포기). 먼저 **현 스택에서 몇 번 걸리는지**를 본다 —
#   과거 코퍼스 101건(057:54 · 055:37)은 옛 런 분포이고 현 스택 예측치가 아니다(W-4).
#   ⚠`distinct_args` 는 T2′ 에서 **호출부가 없어 한 번도 안 돌았다**([[81]]·§T-14). 이제 배선됐고
#     `test_lever_wiring.py` 가 그것을 강제한다.
export T2_VIEW_SCALE=auto
unset T2_VIEW_COMPACT_MINTOTAL
export T2_VIEW_MSG_CAP=0
export T2_SIBLING_PAREN=log
export T2_DISTINCT_ARGS=log
# ★§T-15 — 교차그룹 동일값(같은 혜택 이중계상). 094·095 가 같은 기전이고 부호표는 15/15 오답·정답 0.
export T2_GROUP_DUP=log

# ── viewmax2 (2026-09-01) : 뷰 총량 임계만 50% → 75% 로 올린다.
#   왜: `view_thresholds` 가 auto 에서 min_total = cap*0.5*3.5 = 229,376자(=컨텍스트 50%)를 주는데,
#   배치3 실측 프롬프트는 p50 19,499 · p90 40,676 · p99 59,136 · **max 63,677 토큰(48.6%)** 이라
#   **경계에서 계속 발화**한다. 그 지움이 실패를 만든 실물이 있다 — 084 msg108 은 doc_031 의
#   category enum·card_action 매핑을 담은 메시지가 **전부 다이제스트**돼 틀렸다.
#   ⚠`max_tokens`·`thinking_token_budget` 은 **건드리지 않는다** — TRUNC 는 배치3 에서 1건이고,
#     2026-08-31 기록 축자: "상한을 올리는 대신 **사고에만 예산**을 걸어 답 자리를 남긴다".
#   [[70]] 파는 것: 프리필이 길어져 런 시간이 는다 · Q3.8 장문맥 품질은 미측정 ⇒ **짝 A/B 필수**.
export T2_VIEW_COMPACT_MINTOTAL=344064   # = 131072 * 0.75 * 3.5
