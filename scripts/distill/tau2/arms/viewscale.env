# ★§T-6a — 뷰-압축 문턱을 **모델 컨텍스트에서 유도**한다.
#   근거(실측·밤샘런 GEN_TRACE 1,994건): 프롬프트 p50 20,422 · p90 37,164 · p99 54,171 ·
#   max 60,083 토큰 ↔ 컨텍스트 131,072 ⇒ **최대가 46%**. 그런데 구 문턱 60,000자는
#   ≈15k 토큰 = 컨텍스트의 **11%** 에서 지우기 시작한다. 지우면 다시 읽고, 재열람이 스텝을 태운다
#   (base 51~81 메시지·shell 0~13 ↔ ours 209~293·88~163 · `max_steps` 6/30).
#   파생식: min_total = cap×0.5×3.5자 · msg_cap = cap/4 (`view_thresholds`·단위검정 6/6).
export T2_VIEW_SCALE=auto
# ⚠명시 값은 두지 않는다 — 모델을 바꾸면 파생식이 따라와야 한다.
# ⛔`go_stack.sh:272` 가 `T2_VIEW_COMPACT_MINTOTAL=60000` 을 **명시로** export 한다. 명시값이
#   파생식을 이기므로, 지우지 않으면 이 팔은 **아무 일도 안 한다**([[81]] 고쳐 놓고 켠 적 없는 레버).
#   실제로 첫 발사에서 `arm=viewscale` 인데 `view_mintotal=60000` 이 찍혔다 — 계기가 잡았다.
unset T2_VIEW_COMPACT_MINTOTAL
unset T2_VIEW_MSG_CAP
