# Qwen/Qwen2.5-32B-Instruct-GPTQ-Int8 — 2026-07~08 런의 모델 (레거시 대조군)
#
# 서버 기동 인자 축자(serve8140_32b_0730.log · serve8141_32b_0730night.log · serve8142_32b_x624.log):
#   {'enable_auto_tool_choice': True, 'tool_call_parser': 'hermes',
#    'rope_scaling': {'rope_type': 'yarn', 'factor': 1.375,
#                     'original_max_position_embeddings': 32768},
#    'max_model_len': 44672}
#   ⚠reasoning_parser 없음 — 이 모델은 사고 블록을 따로 내지 않는다.

# 표면형 = hermes. `t2_guided_patch` 의 원래 문법이 이것이고 C162 가 이 조합에서 검증됐다.
export T2_TOOL_SURFACE=hermes

# 문맥 상한 = 44,672 (yarn 확장). `_ctx_fits` 의 종전 하드코딩 값이 바로 이것이다.
export T2_MAX_MODEL_LEN=44672

# 생성 상한 8192 — C271: 한 번 빼봤다가 첫 런에서 폭주가 재현돼 되돌린 값([[82]]).
export T2_AGENT_MAX_TOKENS=8192

# 이 모델에서는 정지어 수리를 쓴 적이 없다(2026-08-30 도입이고 표적은 Q3.8 이었다).
export T2_STOP_FIRST_TOOLCALL=0

# 사고 예산 — 이 모델은 `reasoning_parser` 없이 떴다(사고 블록을 따로 내지 않는다).
#   `thinking_token_budget` 은 Qwen3 계열 기능이라 여기서는 **선언하지 않는다**(무해하게 무시되나,
#   근거 없는 값을 남기지 않는다). 전손 위험도 이 모델에서는 관측된 적이 없다.

# ── 프로브/사고 (모델에 매인 값 · [[82]]/[[84]])
export T2_PROBE_MAX_TOKENS=256   # 이 모델은 reasoning 을 쓰지 않는다 — 종전 값 유지(회귀 방지)
# ── 뷰-압축 (컨텍스트에 매인 값 · §T-6a)
#   ⚠지금은 **실험 축**이라 `arms/{ctl,viewscale}.env` 가 갖는다. A/B 가 끝나면 이 줄로 내려온다:
#   T2_VIEW_SCALE=off   → 60,000자 / 8,000자 (이 값이 유도된 바로 그 컨텍스트다)
