# 사고 예산 — 미선언(위 32B 프로필과 같은 이유: reasoning_parser 없음).

# ── 프로브/사고 (모델에 매인 값 · [[82]]/[[84]])
export T2_PROBE_MAX_TOKENS=256   # 이 모델은 reasoning 을 쓰지 않는다 — 종전 값 유지
# ── 뷰-압축 (컨텍스트에 매인 값 · §T-6a)
