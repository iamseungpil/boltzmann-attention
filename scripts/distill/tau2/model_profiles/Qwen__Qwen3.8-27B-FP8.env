# Qwen/Qwen3.8-27B-FP8 — 2026-08-31 기준 (포트 8141·8143)
#
# 서버 기동 인자 축자(serve8141_opt.log · serve8143_pfx.log):
#   {'enable_auto_tool_choice': True, 'tool_call_parser': 'qwen3_coder',
#    'reasoning_parser': 'qwen3', 'max_model_len': 131072, 'enable_prefix_caching': True,
#    'max_num_seqs': 128}

# 도구 호출 표면형 — 파서가 qwen3_coder 이고 모델 템플릿도 같은 것을 시킨다:
#   chat_template.jinja 축자 "an inner <function=...> block must be nested within
#   <tool_call></tool_call> XML tags" · vLLM parser/qwen3.py:7-11
# 격리 x703(n=3·결정론): hermes 문법 native 0/3 ↔ qwen3_xml 문법 native 3/3(병렬 2호출 유지)
export T2_TOOL_SURFACE=qwen3_xml

# 문맥 상한 — 서버 실측값. 미선언이면 t2_run_gated 가 /v1/models 에서 읽어 채운다.
export T2_MAX_MODEL_LEN=131072

# 생성 상한 — 정본 go_stack(8192)을 그대로 쓴다.
#   base 궤적 1,713콜 분포: p50 268 · p90 1,778 · p99 7,408 · max 17,075 ·
#   completion_tokens ≥3072 가 106/1713 = 6.19%. 3072 캡은 그 6%를 전손시켰다
#   (mt=8192 x681 전손 0/30 ↔ mt=3072 x687·688·689·692·693 각 1~3건).
# ⚠[[82]]: 8192 는 Q2.5 기준으로 정해진 값이다 — Q3.8 폭주 분포 재측정 전까지 유지.
export T2_AGENT_MAX_TOKENS=8192

# 첫 tool_call 에서 생성 끊기 — OFF.
#   2026-08-30 표면형 오진의 증상 수리였고, 병렬 발사를 판다(x703: 같은 프롬프트 2호출 → 1호출).
export T2_STOP_FIRST_TOOLCALL=0

# 사고 예산 — **매 호출에 따로 준다**(상한에서 파생하지 않는다·2026-08-31 사용자 지시).
#   격리 x705(같은 서버·n=2·결정론): 예산 없이 상한이 사고 도중에 걸리면 전손 2/2
#   (`content=0B`), 예산을 주면 **0/2**(mt 512·예산 256 → content 1,046B / mt 2048·예산 1024
#   → finish=stop). 도구가 있을 때도 tool_calls 1 정상.
#   ⚠너무 조이면 답이 바뀐다 — 선행 실측 "486토큰에서 답이 바뀐다". 그래서 넉넉히 준다.
#   본 응답: 상한 8192 중 4096 을 사고에, 나머지 4096 을 답 자리로 남긴다.
export T2_THINK_BUDGET=4096
#   판단 프로브: 사고 4096 · 상한 **8192** (사용자 지시 2026-08-31 *"사고가 4096 이면 전체는 8K"*).
#   ⛔초판은 상한도 4096 이라 예산==상한 = **보호가 꺼진 상태**였다. x706 축자:
#     `call=intent_operator_formalize max_tokens=4096 -> gen=4096 **TRUNC** reason=18,535B content=0B`
#     같은 런의 다른 프로브가 gen 2,171·3,965 로 상한 바로 밑을 오갔다(x707 3,965) ⇒ 답 전손은
#     시간 문제였다. 예산은 **상한보다 작아야** 답 자리가 남는다(격리 x705).
#   ⇒ 사고는 4096 그대로 두고 **상한을 8192 로** 올려 답 자리 4096 을 확보한다(비율 1:2).
#   ⚠엔진에도 레일이 있다: 예산 ≥ 상한이면 상한÷2 로 조이고 로그를 남긴다(선언 실수 방지).
export T2_PROBE_THINK_BUDGET=4096
export T2_JUDGE_MAX_TOKENS=8192
